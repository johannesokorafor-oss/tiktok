# ============================================================
# TikTok Auto-Poster configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# ---------- General ----------
# Dry run: run the FULL pipeline (parse, cover, video, validation, persistence)
# but never contact TikTok. Recommended for first runs. Default: true
DRY_RUN=true

# Root for all runtime directories (input/, output/, ...). Default: repo dir.
#TTA_HOME=C:\tiktok-auto

# ---------- Watcher ----------
# Seconds a file's size must stay unchanged before it is considered stable.
STABILIZE_SECONDS=3
# Poll interval of the folder scanner in seconds.
SCAN_INTERVAL=2
# How long to wait for the second file of a pair before failing (seconds).
PAIR_TIMEOUT=600
# Max automatic retries for a failed job.
MAX_RETRIES=2

# ---------- Image generation ----------
# auto | local | pollinations | comfyui | openai
IMAGE_PROVIDER=auto
# Safety switch: paid providers refuse to run unless this is true. Default: false
ALLOW_PAID_API=false
# If the selected provider fails, fall back to the built-in local renderer.
IMAGE_FALLBACK_TO_LOCAL=true

# ComfyUI-compatible local API (LOCAL, free, needs a running ComfyUI server)
#COMFYUI_URL=http://127.0.0.1:8188
# Optional: path to a custom ComfyUI workflow JSON template
#COMFYUI_WORKFLOW=

# OpenAI Images (PAID - only used if IMAGE_PROVIDER=openai AND ALLOW_PAID_API=true)
#OPENAI_API_KEY=

# ---------- Cover ----------
# Duration of the embedded cover frame segment at the start of the video (ms).
COVER_DURATION_MS=500

# ---------- Video ----------
# Paths to ffmpeg/ffprobe. Leave empty to use the ones found on PATH.
#FFMPEG_PATH=
#FFPROBE_PATH=

# ---------- TikTok API (official Content Posting API) ----------
# Create an app at https://developers.tiktok.com, add the "Content Posting API"
# product and the video.upload scope. See docs/TIKTOK_SETUP.md.
#TIKTOK_CLIENT_KEY=
#TIKTOK_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the TikTok developer portal.
TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/callback/
# inbox = upload as draft for in-app review (recommended, default)
# direct = direct post (requires audited app; posts as SELF_ONLY by default)
UPLOAD_MODE=inbox
# Only used for UPLOAD_MODE=direct
DIRECT_POST_PRIVACY=SELF_ONLY

# ---------- Dashboard ----------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
