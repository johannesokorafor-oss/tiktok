# ==========================================================================
# TikTok Cover & Upload Automation - configuration
# Copy this file to .env and fill in your values.  NEVER commit .env.
# ==========================================================================

# ------------------------- operating modes --------------------------------
# Three explicit modes:
#   DRY_RUN      -> produce cover + video locally, upload NOTHING (default)
#   DRAFT_UPLOAD -> official inbox/draft upload; you review + publish in TikTok
#   DIRECT_POST  -> opt-in, needs CONFIRM_DIRECT_POST=true and video.publish
APP_MODE=DRAFT_UPLOAD
# Safety net: while DRY_RUN=true nothing is ever uploaded, whatever APP_MODE says.
DRY_RUN=true
# TIKTOK_MOCK=true -> exercise the upload code path without network calls
#                  (integration rehearsals only, never a production path).
TIKTOK_MOCK=false
# Video encoding quality: FAST | BALANCED | HIGH_QUALITY (CRF/preset only)
QUALITY_MODE=BALANCED
# Fallback language when detection is inconclusive (de | en)
DEFAULT_LANGUAGE=de

# ------------------------- folders ----------------------------------------
# Defaults are relative to the repository root; absolute paths also work.
# INPUT_DIR=C:\TikTok\input
# OUTPUT_DIR=C:\TikTok\output

# ------------------------- watcher ----------------------------------------
WATCH_RECURSIVE=true
STABILITY_SECONDS=4
POLL_INTERVAL_SECONDS=2
VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm
METADATA_EXTENSIONS=.txt,.md

# also copy the untouched source video into output/<name>/source.<ext>
COPY_SOURCE_TO_OUTPUT=true

# ------------------------- thumbnail / cover -------------------------------
# There is NO automatic cover/thumbnail generation. You create your thumbnail
# yourself and select it inside TikTok when you finish the post.
# (No image API keys, no ComfyUI, no diffusion model, no image costs.)

# ------------------------- video ------------------------------------------
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
VIDEO_CRF=20
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
# auto  = only re-encode when the source is not TikTok compatible (default)
# always = always re-encode | never = only copy/remux, never re-encode
VIDEO_NORMALIZATION=auto
# convert non-9:16 sources to 1080x1920 (blurred pad / crop). false keeps the
# original aspect ratio untouched.
ENFORCE_VERTICAL=true

# ------------------------- TikTok -----------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/tiktok/callback
# UPLOAD  -> /v2/post/publish/inbox/video/init/ (draft in the creator inbox,
#            user finishes the post in TikTok)  -> scope video.upload
# DIRECT_POST -> /v2/post/publish/video/init/   -> scope video.publish (audit needed)
TIKTOK_POST_MODE=UPLOAD
# Extra confirmation required before the app may ever use DIRECT_POST.
CONFIRM_DIRECT_POST=false
TIKTOK_SCOPES=user.info.basic,video.upload
# Tokens are stored in state/tiktok_tokens.json after the OAuth flow.
# These are only a seed for headless setups - leave empty normally.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# API hosts (only change these if TikTok changes them)
# TIKTOK_API_BASE=https://open.tiktokapis.com
# TIKTOK_AUTH_BASE=https://www.tiktok.com
# upload chunk size in bytes (5 MB - 64 MB per the documented chunk rules)
TIKTOK_UPLOAD_CHUNK_SIZE=67108864
# how long to poll the publish status after an upload
TIKTOK_STATUS_POLL_SECONDS=4
TIKTOK_STATUS_POLL_MAX=30
TIKTOK_MAX_RETRIES=5
TIKTOK_BACKOFF_BASE_SECONDS=2
# Only set true when the VIDEO ITSELF is AI-generated. An AI-generated
# thumbnail alone does not make the video AI-generated content.
CONTENT_IS_AIGC=false

# maximum caption length TikTok accepts
CAPTION_MAX_CHARS=2200

# ------------------------- Instagram (OPTIONAL, off by default) ------------
# Instagram is an optional second platform. While disabled, the app makes no
# Instagram API calls at all and needs no Instagram credentials.
INSTAGRAM_ENABLED=false
# PREPARE_ONLY   (default, recommended): no Instagram API call at all. The app
#                validates the video, writes instagram_ready.mp4 and
#                caption_instagram.txt, and you upload/publish manually in the
#                Instagram app. Nothing can expire.
# API_STAGE_ONLY (optional, advanced): uses the official Content Publishing API
#                to create and fill a media *container*. A container is NOT an
#                Instagram mobile-app draft and expires after 24 hours.
#                Publishing is still never performed by this application.
INSTAGRAM_MODE=PREPARE_ONLY
# Hard safety switch. Automatic publishing is refused by design even if set true.
INSTAGRAM_AUTO_PUBLISH=false
# Cover/thumbnail is always chosen by you inside Instagram.
INSTAGRAM_COVER_MODE=MANUAL

# INSTAGRAM_LOGIN  = "Instagram API with Instagram Login" (graph.instagram.com,
#                    no Facebook Page needed). Meta documents resumable local
#                    uploads as NOT available here -> a public HTTPS video_url
#                    is required (INSTAGRAM_PUBLIC_VIDEO_URL_TEMPLATE).
# FACEBOOK_LOGIN   = "Instagram API with Facebook Login" (graph.facebook.com +
#                    rupload.facebook.com). The only configuration for which
#                    Meta documents upload_type=resumable (local file upload).
INSTAGRAM_LOGIN_MODE=INSTAGRAM_LOGIN
# AUTO | RESUMABLE | VIDEO_URL
INSTAGRAM_UPLOAD_METHOD=AUTO
# Public HTTPS URL of the finished MP4 (only for the VIDEO_URL method).
# {filename}, {name} and {parent} are substituted. Host it yourself; do not use
# random public file-sharing services.
INSTAGRAM_PUBLIC_VIDEO_URL_TEMPLATE=

# Credentials below are ONLY needed for INSTAGRAM_MODE=API_STAGE_ONLY.
# An Instagram Professional account (Business or Creator) is required for it.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8765/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_API_VERSION=v23.0
# Tokens are stored in state/instagram_tokens.json after the OAuth flow.
# Seed values for headless setups only - leave empty normally.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Reels container handling
INSTAGRAM_SHARE_TO_FEED=true
INSTAGRAM_STATUS_POLL_SECONDS=10
INSTAGRAM_STATUS_POLL_MAX=60
INSTAGRAM_MAX_RETRIES=4
INSTAGRAM_BACKOFF_BASE_SECONDS=2
# Meta expires unpublished media containers after 24 hours
INSTAGRAM_CONTAINER_TTL_HOURS=24

# =========================================================================
# OPTIONAL EXTRA PLATFORMS - all disabled by default, none ever publishes
# =========================================================================

# ------------------------- Vimeo (real API upload, private) ----------------
# Requires Vimeo "upload access" approval for your app/account and a token
# with the upload+edit scopes. The video is created with privacy.view=nobody.
VIMEO_ENABLED=false
VIMEO_MODE=UPLOAD_PRIVATE
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_REDIRECT_URI=http://localhost:8765/vimeo/callback
VIMEO_SCOPES=upload edit private
VIMEO_ACCESS_TOKEN=
# nobody | password | disable  (anybody/unlisted/users are refused)
VIMEO_PRIVACY_VIEW=nobody
VIMEO_CHUNK_SIZE=33554432
VIMEO_MAX_RETRIES=4

# ------------------------- Dailymotion (real API v2 upload, private) -------
# API v2 only. Create a PRIVATE API key in Dailymotion Studio and use the
# video.manage scope. visibility=public is refused by this application.
DAILYMOTION_ENABLED=false
DAILYMOTION_MODE=UPLOAD_PRIVATE
DAILYMOTION_CLIENT_ID=
DAILYMOTION_CLIENT_SECRET=
# optional: owner credentials for the password grant (otherwise client_credentials)
DAILYMOTION_USERNAME=
DAILYMOTION_PASSWORD=
DAILYMOTION_SCOPE=video.manage
DAILYMOTION_PROFILE_ID=
# private | password   (public is refused)
DAILYMOTION_VISIBILITY=private
DAILYMOTION_CATEGORY=news
DAILYMOTION_IS_FOR_KIDS=false

# ------------------------- SoundCloud (audio) ------------------------------
# OAuth 2.1 + PKCE. Audio is extracted from the video (FLAC by default);
# artwork is never generated - you set it in SoundCloud.
SOUNDCLOUD_ENABLED=false
SOUNDCLOUD_MODE=UPLOAD_PRIVATE
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:8765/soundcloud/callback
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_REFRESH_TOKEN=
# The current official upload example documents only track[title], track[artist]
# and track[asset_data]. Until YOU verify the private-sharing field in the
# current OpenAPI spec, the platform is downgraded to PREPARE_ONLY instead of
# guessing. Set to true only after verifying it.
SOUNDCLOUD_PRIVATE_FIELD_VERIFIED=false
SOUNDCLOUD_PRIVATE_FIELD=track[sharing]
SOUNDCLOUD_PRIVATE_VALUE=private
# flac | wav | mp3
SOUNDCLOUD_AUDIO_FORMAT=flac

# ------------------------- Patreon (prepare only) --------------------------
# Patreon API v2 documents no post creation / media upload for third parties
# (v1 retires 2026-10-07 and is never used here), so this is PREPARE_ONLY.
PATREON_ENABLED=false
PATREON_MODE=PREPARE_ONLY
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=http://localhost:8765/patreon/callback
PATREON_SCOPES=identity campaigns campaigns.posts
# optional creator token, only used for a read-only identity check
PATREON_ACCESS_TOKEN=
PATREON_ACCESS_RECOMMENDATION=patrons-only

# ------------------------- Rumble (prepare only) ---------------------------
# No official public VOD upload API is documented (only the read-only Live
# Stream API), so files are prepared for a manual upload.
RUMBLE_ENABLED=false
RUMBLE_MODE=PREPARE_ONLY
RUMBLE_CHANNEL=
RUMBLE_LICENSE_OPTION=Rumble Only

# ------------------------- advanced host/retry overrides -------------------
# Only change these if a platform changes its API hosts.
# VIMEO_API_BASE=https://api.vimeo.com
# VIMEO_AUTH_BASE=https://api.vimeo.com
# VIMEO_API_VERSION=3.4
# VIMEO_BACKOFF_BASE_SECONDS=2
# DAILYMOTION_API_BASE=https://api.dailymotion.com
# DAILYMOTION_REDIRECT_URI=http://localhost:8765/dailymotion/callback
# DAILYMOTION_MAX_RETRIES=4
# DAILYMOTION_BACKOFF_BASE_SECONDS=2
# SOUNDCLOUD_API_BASE=https://api.soundcloud.com
# SOUNDCLOUD_AUTH_BASE=https://secure.soundcloud.com
# SOUNDCLOUD_MAX_FILE_MB=4096
# SOUNDCLOUD_MAX_RETRIES=4
# SOUNDCLOUD_BACKOFF_BASE_SECONDS=2
# PATREON_API_BASE=https://www.patreon.com/api/oauth2/v2
# PATREON_OAUTH_BASE=https://www.patreon.com/api/oauth2
# INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
# INSTAGRAM_FACEBOOK_GRAPH_BASE=https://graph.facebook.com
# INSTAGRAM_RUPLOAD_BASE=https://rupload.facebook.com
# INSTAGRAM_AUTH_BASE=https://www.instagram.com
# INSTAGRAM_TOKEN_BASE=https://api.instagram.com

# ------------------------- dashboard / logging ----------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
LOG_LEVEL=INFO
