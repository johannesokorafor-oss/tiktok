# ==========================================================================
# TikTok Cover & Upload Automation - configuration
# Copy this file to .env and fill in your values.  NEVER commit .env.
# ==========================================================================

# ------------------------- operating modes --------------------------------
# Three explicit modes:
#   DRY_RUN      -> produce cover + video locally, upload NOTHING (default)
#   DRAFT_UPLOAD -> official inbox/draft upload; you review + publish in TikTok
#   DIRECT_POST  -> opt-in, needs CONFIRM_DIRECT_POST=true and video.publish
APP_MODE=DRAFT_UPLOAD
# Safety net: while DRY_RUN=true nothing is ever uploaded, whatever APP_MODE says.
DRY_RUN=true
# TIKTOK_MOCK=true -> exercise the upload code path without network calls
#                  (integration rehearsals only, never a production path).
TIKTOK_MOCK=false
# Hard safety switch: when false, no paid image API may be called.
ALLOW_PAID_API=false
# FAST | BALANCED | HIGH_QUALITY
QUALITY_MODE=BALANCED
# AUTO | CINEMATIC_MYSTICAL | DARK_LUXURY | CLEAN_MODERN
STYLE_PRESET=AUTO
# Fallback language when detection is inconclusive (de | en)
DEFAULT_LANGUAGE=de

# ------------------------- folders ----------------------------------------
# Defaults are relative to the repository root; absolute paths also work.
# INPUT_DIR=C:\TikTok\input
# OUTPUT_DIR=C:\TikTok\output

# ------------------------- watcher ----------------------------------------
WATCH_RECURSIVE=true
STABILITY_SECONDS=4
POLL_INTERVAL_SECONDS=2
VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm
METADATA_EXTENSIONS=.txt,.md

# ------------------------- image generation -------------------------------
# auto = use PRIMARY then FALLBACK chain; or name one provider explicitly.
IMAGE_PROVIDER=auto
IMAGE_PROVIDER_PRIMARY=pollinations
IMAGE_PROVIDER_FALLBACK=comfyui,automatic1111,offline
IMAGE_TIMEOUT_SECONDS=180
# retries per provider before falling through to the next one in the chain
IMAGE_MAX_RETRIES=2
IMAGE_BACKOFF_BASE_SECONDS=2
# 1 = one image (default).  HIGH_QUALITY mode generates 3 and scores them.
IMAGE_CANDIDATES=1
# The offline Pillow renderer is a TECHNICAL FALLBACK, not an AI image model.
# Covers produced by it are labelled OFFLINE_FALLBACK_GENERATED everywhere.
ALLOW_OFFLINE_IMAGE_FALLBACK=true
# In QUALITY_MODE=HIGH_QUALITY a real image model is required; set this to true
# to explicitly accept the offline renderer during dry runs.
DRY_RUN_ALLOW_OFFLINE=true
# Providers whose current pricing cannot be verified are reported as UNKNOWN.
# Set to false to refuse them entirely instead of using them.
ALLOW_UNKNOWN_TIER_PROVIDERS=true
PROVIDER_TIER_CACHE_SECONDS=900

# Pollinations - the tier is resolved at runtime from the provider's own model
# catalogue. If it cannot be verified the provider is shown as UNKNOWN, never
# as FREE. Set POLLINATIONS_TIER yourself only after checking current pricing.
POLLINATIONS_MODEL=flux
# POLLINATIONS_TIER=FREE
# POLLINATIONS_TOKEN=          # optional free registered token (higher limits)

# ComfyUI (local)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# COMFYUI_WORKFLOW_FILE=C:\path\to\workflow_api.json

# AUTOMATIC1111 WebUI (local, started with --api)
AUTOMATIC1111_BASE_URL=http://127.0.0.1:7860

# Hugging Face - FREE WITH QUOTA (monthly credits, then requires paid plan)
# HUGGINGFACE_API_TOKEN=
# HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-schnell
# HUGGINGFACE_ACCEPT_QUOTA=false

# also copy the untouched source video into output/<name>/source.<ext>
COPY_SOURCE_TO_OUTPUT=true

# ------------------------- cover ------------------------------------------
COVER_WIDTH=1080
COVER_HEIGHT=1920
COVER_FORMAT=PNG
# Optional explicit fonts (no font files are shipped with this repository)
# FONT_BOLD=C:\Windows\Fonts\segoeuib.ttf
# FONT_REGULAR=C:\Windows\Fonts\segoeui.ttf

# ------------------------- video ------------------------------------------
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
VIDEO_CRF=20
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
# milliseconds the generated cover is shown at the very start of the video
COVER_FRAME_HOLD_MS=120

# ------------------------- TikTok -----------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/tiktok/callback
# UPLOAD  -> /v2/post/publish/inbox/video/init/ (draft in the creator inbox,
#            user finishes the post in TikTok)  -> scope video.upload
# DIRECT_POST -> /v2/post/publish/video/init/   -> scope video.publish (audit needed)
TIKTOK_POST_MODE=UPLOAD
# Extra confirmation required before the app may ever use DIRECT_POST.
CONFIRM_DIRECT_POST=false
TIKTOK_SCOPES=user.info.basic,video.upload
# Tokens are stored in state/tiktok_tokens.json after the OAuth flow.
# These are only a seed for headless setups - leave empty normally.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_MAX_RETRIES=5
TIKTOK_BACKOFF_BASE_SECONDS=2
# Only set true when the VIDEO ITSELF is AI-generated. An AI-generated
# thumbnail alone does not make the video AI-generated content.
CONTENT_IS_AIGC=false

# ------------------------- dashboard / logging ----------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
LOG_LEVEL=INFO
