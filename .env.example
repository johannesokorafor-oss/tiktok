# ==========================================================================
# TikTok Cover & Upload Automation - configuration
# Copy this file to .env and fill in your values.  NEVER commit .env.
# ==========================================================================

# ------------------------- operating modes --------------------------------
# Three explicit modes:
#   DRY_RUN      -> produce cover + video locally, upload NOTHING (default)
#   DRAFT_UPLOAD -> official inbox/draft upload; you review + publish in TikTok
#   DIRECT_POST  -> opt-in, needs CONFIRM_DIRECT_POST=true and video.publish
APP_MODE=DRAFT_UPLOAD
# Safety net: while DRY_RUN=true nothing is ever uploaded, whatever APP_MODE says.
DRY_RUN=true
# TIKTOK_MOCK=true -> exercise the upload code path without network calls
#                  (integration rehearsals only, never a production path).
TIKTOK_MOCK=false
# Video encoding quality: FAST | BALANCED | HIGH_QUALITY (CRF/preset only)
QUALITY_MODE=BALANCED
# Fallback language when detection is inconclusive (de | en)
DEFAULT_LANGUAGE=de

# ------------------------- folders ----------------------------------------
# Defaults are relative to the repository root; absolute paths also work.
# INPUT_DIR=C:\TikTok\input
# OUTPUT_DIR=C:\TikTok\output

# ------------------------- watcher ----------------------------------------
WATCH_RECURSIVE=true
STABILITY_SECONDS=4
POLL_INTERVAL_SECONDS=2
VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm
METADATA_EXTENSIONS=.txt,.md

# also copy the untouched source video into output/<name>/source.<ext>
COPY_SOURCE_TO_OUTPUT=true

# ------------------------- thumbnail / cover -------------------------------
# There is NO automatic cover/thumbnail generation. You create your thumbnail
# yourself and select it inside TikTok when you finish the post.
# (No image API keys, no ComfyUI, no diffusion model, no image costs.)

# ------------------------- video ------------------------------------------
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
VIDEO_CRF=20
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
# auto  = only re-encode when the source is not TikTok compatible (default)
# always = always re-encode | never = only copy/remux, never re-encode
VIDEO_NORMALIZATION=auto
# convert non-9:16 sources to 1080x1920 (blurred pad / crop). false keeps the
# original aspect ratio untouched.
ENFORCE_VERTICAL=true

# ------------------------- TikTok -----------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/tiktok/callback
# UPLOAD  -> /v2/post/publish/inbox/video/init/ (draft in the creator inbox,
#            user finishes the post in TikTok)  -> scope video.upload
# DIRECT_POST -> /v2/post/publish/video/init/   -> scope video.publish (audit needed)
TIKTOK_POST_MODE=UPLOAD
# Extra confirmation required before the app may ever use DIRECT_POST.
CONFIRM_DIRECT_POST=false
TIKTOK_SCOPES=user.info.basic,video.upload
# Tokens are stored in state/tiktok_tokens.json after the OAuth flow.
# These are only a seed for headless setups - leave empty normally.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# API hosts (only change these if TikTok changes them)
# TIKTOK_API_BASE=https://open.tiktokapis.com
# TIKTOK_AUTH_BASE=https://www.tiktok.com
# upload chunk size in bytes (5 MB - 64 MB per the documented chunk rules)
TIKTOK_UPLOAD_CHUNK_SIZE=67108864
# how long to poll the publish status after an upload
TIKTOK_STATUS_POLL_SECONDS=4
TIKTOK_STATUS_POLL_MAX=30
TIKTOK_MAX_RETRIES=5
TIKTOK_BACKOFF_BASE_SECONDS=2
# Only set true when the VIDEO ITSELF is AI-generated. An AI-generated
# thumbnail alone does not make the video AI-generated content.
CONTENT_IS_AIGC=false

# maximum caption length TikTok accepts
CAPTION_MAX_CHARS=2200

# ------------------------- dashboard / logging ----------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
LOG_LEVEL=INFO
